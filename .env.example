# Kickstart/CRM config — read via pydantic-settings (12-factor ENV VARS), NOT app.config.
# The crm module is framework-agnostic (dtapp/kickstart/core/config.py). Mirror this in your .env.

# Deployment env (mirrors axle's DTADMIN_ENV) — usually set by run-local.sh (dev) / deploy (prod),
# not here. Drives env-resolved routing in core/recipients.py. Default prod = fail-closed.
DTADMIN_ENV=dev

# PostgreSQL for CRM tables
CRM_DB_HOST=localhost
CRM_DB_NAME=axle
CRM_DB_USER=postgres
CRM_DB_PORT=5432
CRM_DB_PASS=

# SQS — Axle's own provisioning queue. App self-creates it by name (needs sqs:*). Set
# KICKSTART_SQS_ENDPOINT_URL for ElasticMQ/LocalStack (blank → real AWS SQS).
KICKSTART_PROVISIONING_QUEUE_NAME=kickstart-provisioning
KICKSTART_SQS_ENDPOINT_URL=
AWS_REGION=us-east-1

# Intake form URL base (token appended as /intake/<token>)
CRM_FORM_BASE_URL=https://app.drivetrain.ai

# Okta JWT — only the ISSUER varies per env (audience is a constant, constants.OKTA_AUDIENCE)
OKTA_ISSUER=https://drivetrain.okta.com/oauth2/default

# LaunchDarkly server SDK key — server-side gating (assign/debug) + verify-tenant feature flag.
# Blank → LD not enforced (local permissive). See core/flags.py.
LAUNCHDARKLY_SDK_KEY=

# Drive internal API — Grand Central host for tenant provisioning. MUST include Drive's context-path
# if any (dev = /drive); client appends /api/v1/internal/axle/... Local: http://localhost:8080/drive
DRIVE_INTERNAL_BASE_URL=http://localhost:8080/drive
AXLE_API_KEY=

# SendGrid (intake email). Blank → dry-run in non-prod, fail-loud in prod.
SENDGRID_API_KEY=

# Slack — Kickstart Agent bot. Blank → dry-run in non-prod. (Announce channel + the assign-DM
# recipient are env-resolved in core/recipients.py, not here.)
SLACK_BOT_TOKEN=
# Optional: bot user id of the "Drivetrain Support" Slack app, auto-invited to each kickoff channel (blank → skip).
DRIVETRAIN_SUPPORT_BOT_USER_ID=

# verify-tenant escalation targets (only used when kickstart-verify-tenant is on; blank otherwise):
# #ask-sre channel id, @sre-team usergroup id, comma-separated cc Slack user ids.
CRM_ASK_SRE_CHANNEL_ID=
CRM_SRE_SUBTEAM_ID=
CRM_ESCALATION_CC_USER_IDS=

# Linear — API key only (teams/assignees are env-resolved in core/recipients.py). Blank → dry-run in non-prod.
LINEAR_API_KEY=

# Monday.com — board item creation on kickoff. Blank → dry-run in non-prod.
MONDAY_API_KEY=
MONDAY_BOARD_ID=

# Google Sheets — full service-account JSON as a single-line string. Blank → dry-run in non-prod.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Consultant roster sheet (default id + tab already baked into CrmSettings)
CRM_CONSULTANT_SHEET_ID=1S1pd3yjOMwtNvlYKVX4p_ybOY9W6LVkxjLc-RO1ILCY
CRM_CONSULTANT_SHEET_TAB=All

# S3 asset storage (MinIO local, real AWS in prod). Creds blank → boto3 default chain (IAM).
CRM_S3_BUCKET=
CRM_S3_ENDPOINT_URL=
CRM_S3_ACCESS_KEY=
CRM_S3_SECRET_KEY=

# ── Access automation (garage/access) — ENG-90754 ──
# Shared-secret header (X-Webhook-Secret) on the Keka webhook. Blank in prod → the route 500s
# (fail-closed, never accepts an unverified webhook); blank in non-prod → accepted unauthenticated.
KEKA_WEBHOOK_SECRET=
KEKA_API_KEY=
KEKA_API_BASE_URL=https://api.keka.com
# Keka as a GRANT TARGET (the employee's own Keka login) — separate OAuth2 client, reclassified from
# manual after re-checking Keka's API actually supports employee create + exit management.
KEKA_OAUTH_CLIENT_ID=
KEKA_OAUTH_CLIENT_SECRET=

# Plum (health insurance) — Partner API. Reclassified from manual after re-checking.
PLUM_PARTNER_API_KEY=
PLUM_COMPANY_ID=

# GitHub — org-scoped token for the bespoke org-membership client (most other tools go through the
# generic SCIM client instead, configured per-tool in the access_tool_matrix DB table, not here).
GITHUB_API_TOKEN=
GITHUB_ORG=DrivetrainAi

# Corporate Okta (drivetrain.okta.com) — the "Drivetrain" matrix row's client. DISTINCT from the
# customer-facing product Okta (OKTA_API_TOKEN, dtapp/views/okta.py).
OKTA_CORP_API_TOKEN=
OKTA_CORP_BASE_URL=https://drivetrain.okta.com
OKTA_CORP_DRIVETRAIN_GROUP_ID=

# SCIM tokens for tools wired to the generic SCIM client (access_tool_matrix.client_config
# references these var names via token_env — see dtapp/access/clients/scim_client.py).
POSTMAN_SCIM_TOKEN=
LAUNCHDARKLY_SCIM_TOKEN=
# Datadog uses a bespoke client (dtapp/access/clients/datadog_client.py) — its real API needs BOTH
# headers together (DD-API-KEY + DD-APPLICATION-KEY), not a bearer SCIM token, confirmed live 2026-09-07.
DATADOG_API_KEY=
DATADOG_APP_KEY=
CLAUDE_SCIM_TOKEN=
FIGMA_SCIM_TOKEN=
NOTION_SCIM_TOKEN=
SLACK_SCIM_TOKEN=
ONEPASSWORD_SCIM_TOKEN=
ONEPASSWORD_SCIM_BASE_URL=
APOLLO_SCIM_TOKEN=
APOLLO_SCIM_BASE_URL=
AHREFS_SCIM_TOKEN=
AHREFS_SCIM_BASE_URL=
WEBFLOW_SCIM_TOKEN=
WEBFLOW_SCIM_BASE_URL=
WISTIA_SCIM_TOKEN=
WISTIA_SCIM_BASE_URL=

# Bespoke clients (dtapp/access/clients/) — one block per tool, mirrors garage/core/config.py fields.
POSTHOG_API_KEY=
POSTHOG_ORG_ID=
POSTHOG_BASE_URL=https://app.posthog.com

HUBSPOT_API_TOKEN=
HUBSPOT_DEFAULT_ROLE_ID=

GITBOOK_API_TOKEN=
GITBOOK_ORG_ID=

INSTANTLY_API_KEY=

CLOCKIFY_API_KEY=
CLOCKIFY_WORKSPACE_ID=

CODERABBIT_API_KEY=

TEMPORAL_CLOUD_API_KEY=

MONDAY_HOME_WORKSPACE_ID=

# Microsoft 365 / Entra ID (OAuth2 client-credentials, not a static token)
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# Zoom (OAuth2 Server-to-Server)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Google Workspace — reuses GOOGLE_SERVICE_ACCOUNT_JSON above via domain-wide delegation; only needs
# a real super-admin email to impersonate.
GWORKSPACE_ADMIN_IMPERSONATE_EMAIL=

# AWS IAM Identity Center — reuses this machine's/pod's AWS credential chain, not a separate key.
AWS_IDENTITY_STORE_ID=
AWS_IDENTITY_CENTER_INSTANCE_ARN=
AWS_TARGET_ACCOUNT_ID=
AWS_PERMISSION_SET_ARN=

# GCP IAM — engineers only ever get GCP access on staging + preprod, never prod. ONE credential
# covers both projects plus the revoke-side dynamic sweep (no GCP Organization exists in this setup,
# so there's no folder-level IAM inheritance — a credential with standing per-project access to
# everything it needs is the practical alternative). Distinct from GOOGLE_SERVICE_ACCOUNT_JSON above
# (BigQuery/Workspace, a narrower-scoped identity).
GCP_IAM_SERVICE_ACCOUNT_JSON=
GCP_PROJECT_ID=
GCP_PREPROD_PROJECT_ID=
GCP_DEFAULT_ROLE=roles/viewer

# Access-automation Slack channel overrides (PROD only — non-prod always routes to the existing
# Shahbaz dev-test channel). MUST be set before this module is relied on in prod.
ACCESS_NOTIFY_CHANNEL=
ACCESS_LOGS_CHANNEL=
ACCESS_DRIFT_ALERT_CHANNEL=
# Manual-tool sub-issue Linear routing override (PROD). Blank → falls back to the Eng Dev Testing
# bucket even in prod — a misconfiguration, logged loudly at boot.
ACCESS_DEFAULT_LINEAR_TEAM=
ACCESS_DEFAULT_LINEAR_STATE=
